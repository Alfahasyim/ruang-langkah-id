# ---------------------------------------------------------------------------
# Salin berkas ini menjadi .env.local, lalu isi dengan kredensial proyekmu.
#   cp .env.example .env.local
#
# Ambil nilainya di Supabase Dashboard > Project Settings > Data API.
# .env.local sudah diabaikan oleh .gitignore — jangan pernah commit berkas itu.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# Opsional — hanya untuk skrip admin/server. JANGAN diberi prefix NEXT_PUBLIC_
# dan jangan pernah dipakai di komponen client.
# SUPABASE_SERVICE_ROLE_KEY=
